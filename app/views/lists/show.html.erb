<h1> <%= @list.name %> </h1>

<p> <%= @list.bookmarks.count %> movies </p>

<p> <%= link_to "Add movie", new_list_bookmark_path(@list) %>

<div class="card-container">

<% @list.bookmarks.each do |bookmark| %>
  <%# if bookmark.list_id == @list.id %>
    <div class="movie-card">
    <%= image_tag bookmark.movie.poster_url, size:"298x150", class: "movie-poster" %>
    <p>
    <strong> <%= bookmark.movie.title %> </strong>
    <br>
    <%= bookmark.comment %>
    <br>
    </p>
    <p>
    <%= link_to "Remove", bookmark_path(bookmark), data: { turbo_method: :delete } %>
    </p>
  </div>
  <% end %>
<%# end %>

</div>

<p> <%= link_to "Index", lists_path %> </p>
